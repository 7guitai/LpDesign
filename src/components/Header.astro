---
import { NAV, SITE } from "@/consts";
const path = Astro.url.pathname;
---

<header class="border-b border-ink-100 bg-white/95 backdrop-blur">
  <div class="container-narrow flex h-16 items-center justify-between">
    <a href="/" class="title-serif text-lg font-bold tracking-tight text-ink-900" aria-label={`${SITE.name} トップへ`}>
      {SITE.name}
    </a>
    <nav aria-label="グローバル">
      <ul class="flex items-center gap-6 text-sm">
        {NAV.filter((n) => n.href !== "/").map((item) => {
          const active = path.startsWith(item.href);
          return (
            <li class="hidden md:block">
              <a
                href={item.href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "transition",
                  active
                    ? "text-ink-900 underline underline-offset-4"
                    : "text-ink-600 hover:text-ink-900",
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
