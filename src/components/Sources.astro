---
export interface Props {
  items: { title: string; url: string; publisher?: string; accessedAt?: Date }[];
}
const { items } = Astro.props;
if (!items || items.length === 0) return null;
const fmt = (d: Date) => d.toLocaleDateString("ja-JP", { year: "numeric", month: "numeric", day: "numeric" });
---

<section class="not-prose my-12">
  <p class="text-xs tracking-widest text-ink-500">参考・出典</p>
  <ol class="mt-3 space-y-1.5 text-xs leading-[1.8] text-ink-600">
    {items.map((s, i) => (
      <li>
        <span class="mr-1 text-ink-400">[{i + 1}]</span>
        <a href={s.url} rel="noopener nofollow" target="_blank" class="underline underline-offset-2 hover:text-ink-900">{s.title}</a>
        {s.publisher && <span class="text-ink-500">（{s.publisher}）</span>}
        {s.accessedAt && <span class="text-ink-400">／{fmt(s.accessedAt)}アクセス</span>}
      </li>
    ))}
  </ol>
</section>
