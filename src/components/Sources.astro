---
export interface Props {
  items: { title: string; url: string; publisher?: string; accessedAt?: Date }[];
}
const { items } = Astro.props;
if (!items || items.length === 0) return null;
const fmt = (d: Date) => d.toLocaleDateString("ja-JP", { year: "numeric", month: "numeric", day: "numeric" });
---

<section class="not-prose my-10 rounded-2xl border border-ink-100 bg-ink-50 p-5 text-sm dark:border-ink-800 dark:bg-ink-800/40">
  <h2 class="text-xs font-semibold uppercase tracking-widest text-ink-500">参考・出典</h2>
  <ol class="mt-3 space-y-2 text-ink-700 dark:text-ink-200">
    {items.map((s, i) => (
      <li>
        <span class="mr-2 text-ink-400">[{i + 1}]</span>
        <a href={s.url} rel="noopener nofollow" target="_blank" class="underline underline-offset-2">
          {s.title}
        </a>
        {s.publisher && <span class="text-ink-500">（{s.publisher}）</span>}
        {s.accessedAt && <span class="text-ink-400">／{fmt(s.accessedAt)}アクセス</span>}
      </li>
    ))}
  </ol>
</section>
