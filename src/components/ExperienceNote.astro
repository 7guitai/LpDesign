---
export interface Props {
  usagePeriod?: string;
  context?: string;
  itemsTested?: number;
}
const { usagePeriod, context, itemsTested } = Astro.props;
const hasData = usagePeriod || context || itemsTested;
if (!hasData) return null;
---

<p class="not-prose my-8 border-l-2 border-ink-300 pl-4 text-sm leading-[1.9] text-ink-600">
  この記事は{itemsTested && <><b class="text-ink-900">{itemsTested}製品</b>を</>}
  {usagePeriod && <><b class="text-ink-900">{usagePeriod}</b>、</>}
  {context && <>{context}で</>}
  実際に使い比べた上で書いています。
</p>
