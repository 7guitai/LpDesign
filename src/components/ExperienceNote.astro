---
export interface Props {
  usagePeriod?: string;
  context?: string;
  itemsTested?: number;
}
const { usagePeriod, context, itemsTested } = Astro.props;
const hasData = usagePeriod || context || itemsTested;
if (!hasData) return null;
---

<p class="not-prose my-6 border-l-2 border-ink-400 pl-4 text-sm leading-relaxed text-ink-600 dark:border-ink-500 dark:text-ink-300">
  この記事は{itemsTested && <><b class="text-ink-900 dark:text-ink-50">{itemsTested}製品</b>を</>}
  {usagePeriod && <><b class="text-ink-900 dark:text-ink-50">{usagePeriod}</b>、</>}
  {context && <>{context}で</>}
  実際に使い比べた上で書いています。
</p>
