---
export interface Props {
  items: string[];
  title?: string;
}
const { items, title = "選定の基準" } = Astro.props;
if (!items || items.length === 0) return null;
---

<section class="not-prose my-8 rounded-2xl border border-ink-200 bg-white p-6 dark:border-ink-700 dark:bg-ink-800/40">
  <p class="text-xs font-semibold uppercase tracking-widest text-ink-500">Methodology</p>
  <h2 class="mt-1 text-lg font-semibold tracking-tight">{title}</h2>
  <ol class="mt-3 space-y-2 text-sm text-ink-700 dark:text-ink-200">
    {items.map((item, i) => (
      <li class="flex gap-3">
        <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-ink-900 text-[10px] font-bold text-ink-50">
          {i + 1}
        </span>
        <span>{item}</span>
      </li>
    ))}
  </ol>
</section>
