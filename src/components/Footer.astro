---
import { SITE, CATEGORIES } from "@/consts";
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-ink-100 bg-ink-50/60 dark:border-ink-800 dark:bg-ink-900/60">
  <div class="container-narrow grid gap-10 py-14 md:grid-cols-4">
    <div class="md:col-span-2">
      <p class="text-lg font-semibold tracking-tight">{SITE.name}</p>
      <p class="mt-2 max-w-sm text-sm leading-relaxed text-ink-600 dark:text-ink-300">
        {SITE.description}
      </p>
      <div class="mt-4 flex gap-3 text-sm">
        <a class="btn-outline" href={`https://instagram.com/${SITE.instagram}`} rel="me noopener" target="_blank">Instagram</a>
        <a class="btn-outline" href="/rss.xml">RSS</a>
      </div>
    </div>

    <div>
      <p class="text-xs uppercase tracking-widest text-ink-500">Categories</p>
      <ul class="mt-3 space-y-2 text-sm">
        {CATEGORIES.map((c) => (
          <li><a class="hover:text-ink-900 dark:hover:text-ink-50" href={`/category/${c.slug}`}>{c.name}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="text-xs uppercase tracking-widest text-ink-500">About</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/about" class="hover:text-ink-900 dark:hover:text-ink-50">このサイトについて</a></li>
        <li><a href="/privacy" class="hover:text-ink-900 dark:hover:text-ink-50">プライバシーポリシー</a></li>
        <li><a href="/disclaimer" class="hover:text-ink-900 dark:hover:text-ink-50">免責事項・広告表示</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-ink-100 py-6 text-center text-xs text-ink-500 dark:border-ink-800">
    © {year} {SITE.name}. All rights reserved.
  </div>
</footer>
