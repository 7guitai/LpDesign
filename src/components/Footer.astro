---
import { SITE, CATEGORIES } from "@/consts";
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-ink-200">
  <div class="container-narrow py-14">
    <p class="title-serif text-lg font-semibold text-ink-900">{SITE.name}</p>
    <p class="mt-2 max-w-lg text-sm leading-[1.9] text-ink-600">
      {SITE.description}
    </p>

    <div class="mt-10 grid gap-10 text-sm md:grid-cols-2">
      <div>
        <p class="text-xs tracking-widest text-ink-500">カテゴリ</p>
        <ul class="mt-3 space-y-2">
          {CATEGORIES.map((c) => (
            <li><a class="text-ink-700 hover:text-ink-900 hover:underline underline-offset-4" href={`/category/${c.slug}`}>{c.name}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="text-xs tracking-widest text-ink-500">このサイトについて</p>
        <ul class="mt-3 space-y-2">
          <li><a class="text-ink-700 hover:text-ink-900 hover:underline underline-offset-4" href="/about">運営者プロフィール</a></li>
          <li><a class="text-ink-700 hover:text-ink-900 hover:underline underline-offset-4" href={`https://instagram.com/${SITE.instagram}`} rel="me noopener" target="_blank">Instagram</a></li>
          <li><a class="text-ink-700 hover:text-ink-900 hover:underline underline-offset-4" href="/rss.xml">RSS</a></li>
          <li><a class="text-ink-700 hover:text-ink-900 hover:underline underline-offset-4" href="/privacy">プライバシーポリシー</a></li>
          <li><a class="text-ink-700 hover:text-ink-900 hover:underline underline-offset-4" href="/disclaimer">免責事項・広告表示</a></li>
        </ul>
      </div>
    </div>

    <p class="mt-14 text-xs text-ink-500">© {year} {SITE.name}</p>
  </div>
</footer>
