---
export interface Props {
  items: { q: string; a: string }[];
  heading?: string;
}
const { items, heading = "よくある質問" } = Astro.props;
if (!items || items.length === 0) return null;

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((it) => ({
    "@type": "Question",
    name: it.q,
    acceptedAnswer: { "@type": "Answer", text: it.a },
  })),
};
---

<section class="not-prose my-12">
  <h2 class="title-serif text-xl font-bold">{heading}</h2>
  <div class="mt-4 divide-y divide-ink-200 border-t border-b border-ink-200 dark:divide-ink-800 dark:border-ink-800">
    {items.map((it) => (
      <details class="group py-4">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-base font-medium">
          <span>Q. {it.q}</span>
          <span class="mt-1 shrink-0 text-ink-400 transition group-open:rotate-45">＋</span>
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-ink-600 dark:text-ink-300">A. {it.a}</p>
      </details>
    ))}
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
