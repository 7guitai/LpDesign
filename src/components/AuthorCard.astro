---
import type { CollectionEntry } from "astro:content";
export interface Props {
  author: CollectionEntry<"authors">;
  reviewedBy?: CollectionEntry<"authors">;
  pubDate: Date;
  updatedDate?: Date;
  lastReviewedDate?: Date;
  variant?: "byline" | "full";
}
const { author, reviewedBy, pubDate, updatedDate, lastReviewedDate, variant = "byline" } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString("ja-JP", { year: "numeric", month: "long", day: "numeric" });
---

{variant === "byline" ? (
  <div class="not-prose mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink-500">
    <span>文／<span class="text-ink-800 dark:text-ink-100">{author.data.name}</span></span>
    <span>·</span>
    <span><time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time> 公開</span>
    {updatedDate && <><span>·</span><span><time datetime={updatedDate.toISOString()}>{fmt(updatedDate)}</time> 更新</span></>}
    {reviewedBy && <><span>·</span><span>監修／{reviewedBy.data.name}</span></>}
  </div>
) : (
  <aside class="not-prose my-12 border-t border-b border-ink-200 py-8 dark:border-ink-800">
    <p class="text-xs text-ink-500">この記事を書いた人</p>
    <p class="title-serif mt-1 text-lg font-bold">{author.data.name}</p>
    {author.data.role && <p class="text-sm text-ink-500">{author.data.role}</p>}
    <p class="mt-3 text-sm leading-relaxed text-ink-600 dark:text-ink-300">{author.data.bio}</p>
    {author.data.credentials.length > 0 && (
      <ul class="mt-3 space-y-1 text-xs text-ink-500">
        {author.data.credentials.map((c) => <li>・{c}</li>)}
      </ul>
    )}
    <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink-500">
      <span>公開: <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time></span>
      {updatedDate && <span>更新: <time datetime={updatedDate.toISOString()}>{fmt(updatedDate)}</time></span>}
      {lastReviewedDate && <span>最終確認: <time datetime={lastReviewedDate.toISOString()}>{fmt(lastReviewedDate)}</time></span>}
    </div>
  </aside>
)}
