---
import { CATEGORIES } from "@/consts";
import type { CollectionEntry } from "astro:content";

export interface Props {
  post: CollectionEntry<"posts">;
  featured?: boolean;
}
const { post } = Astro.props;
const { data, slug } = post;
const category = CATEGORIES.find((c) => c.slug === data.category);
const dateLabel = new Date(data.pubDate).toLocaleDateString("ja-JP", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="group py-6">
  <a href={`/posts/${slug}`} class="block">
    <div class="flex items-center gap-3 text-xs text-ink-500">
      <time datetime={new Date(data.pubDate).toISOString()}>{dateLabel}</time>
      {category && <><span>·</span><span>{category.name}</span></>}
    </div>
    <h3 class="title-serif mt-2 text-xl font-bold leading-snug text-ink-900 group-hover:underline underline-offset-4 dark:text-ink-50 md:text-2xl">
      {data.title}
    </h3>
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink-600 dark:text-ink-300">
      {data.description}
    </p>
  </a>
</article>
