---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { getCollection } from "astro:content";
import { CATEGORIES } from "@/consts";

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug }, props: { category: c } }));
}

const { category } = Astro.props;
const posts = (await getCollection("posts", ({ data }) => !data.draft && data.category === category.slug)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title={`${category.name}の記事`}
  description={`${category.name}カテゴリの記事一覧。${category.description}`}
>
  <section class="container-narrow pt-16 pb-10 md:pt-20">
    <p class="text-sm text-ink-500">カテゴリ</p>
    <h1 class="title-serif mt-2 text-3xl font-bold md:text-4xl">{category.name}</h1>
    <p class="mt-4 max-w-xl leading-relaxed text-ink-600 dark:text-ink-300">{category.description}</p>
  </section>

  <section class="container-narrow border-t border-ink-200 py-6 dark:border-ink-800">
    {posts.length === 0 ? (
      <p class="py-8 text-ink-500">記事はまだありません。近日公開予定です。</p>
    ) : (
      <div class="divide-y divide-ink-200 dark:divide-ink-800">
        {posts.map((p) => <PostCard post={p} />)}
      </div>
    )}
  </section>
</BaseLayout>
