---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { getCollection } from "astro:content";
import { CATEGORIES } from "@/consts";

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug }, props: { category: c } }));
}

const { category } = Astro.props;
const posts = (await getCollection("posts", ({ data }) => !data.draft && data.category === category.slug)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title={`${category.name}の記事一覧`}
  description={`${category.name}カテゴリの記事一覧。${category.description}`}
>
  <section class="border-b border-ink-100 py-14 dark:border-ink-800">
    <div class="container-narrow">
      <p class="text-xs uppercase tracking-[0.2em] text-ink-500">Category</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight md:text-5xl">{category.name}</h1>
      <p class="mt-4 max-w-xl text-ink-600 dark:text-ink-300">{category.description}</p>
    </div>
  </section>

  <section class="container-narrow py-12">
    {posts.length === 0 ? (
      <p class="text-ink-500">記事はまだありません。近日公開予定。</p>
    ) : (
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((p) => <PostCard post={p} />)}
      </div>
    )}
  </section>
</BaseLayout>
