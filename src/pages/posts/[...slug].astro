---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Prose from "@/components/Prose.astro";
import PostCard from "@/components/PostCard.astro";
import AuthorCard from "@/components/AuthorCard.astro";
import ExperienceNote from "@/components/ExperienceNote.astro";
import MethodologyBox from "@/components/MethodologyBox.astro";
import FaqList from "@/components/FaqList.astro";
import Sources from "@/components/Sources.astro";
import ShareButtons from "@/components/ShareButtons.astro";
import BackToTop from "@/components/BackToTop.astro";
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import { CATEGORIES, SITE } from "@/consts";
import { readingTime } from "@/utils/readingTime";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props { post: CollectionEntry<"posts"> }
const { post } = Astro.props;
const { Content, headings } = await post.render();
const { data } = post;
const category = CATEGORIES.find((c) => c.slug === data.category);

const author = await getEntry(data.author);
const reviewedBy = data.reviewedBy ? await getEntry(data.reviewedBy) : undefined;

const pubDate = new Date(data.pubDate).toISOString();
const updatedDate = data.updatedDate ? new Date(data.updatedDate).toISOString() : pubDate;

const minutes = readingTime(post.body);

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const related = allPosts
  .filter((p) => p.slug !== post.slug && p.data.category === post.data.category)
  .slice(0, 3);

const canonical = new URL(`/posts/${post.slug}`, SITE.url).toString();
const ogImage = data.cover
  ? new URL(data.cover, SITE.url).toString()
  : new URL(SITE.defaultOgImage, SITE.url).toString();

const personLd = (a: typeof author) => ({
  "@type": "Person",
  name: a.data.name,
  description: a.data.bio,
  jobTitle: a.data.role,
  knowsAbout: a.data.expertise,
  ...(a.data.social.website || a.data.social.instagram
    ? {
        sameAs: [
          a.data.social.website,
          a.data.social.instagram && `https://instagram.com/${a.data.social.instagram}`,
          a.data.social.twitter && `https://twitter.com/${a.data.social.twitter.replace(/^@/, "")}`,
        ].filter(Boolean),
      }
    : {}),
});

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.description,
  image: ogImage,
  datePublished: pubDate,
  dateModified: updatedDate,
  author: personLd(author),
  ...(reviewedBy ? { reviewedBy: personLd(reviewedBy) } : {}),
  publisher: {
    "@type": "Organization",
    name: SITE.name,
    url: SITE.url,
    logo: { "@type": "ImageObject", url: new URL("/favicon.svg", SITE.url).toString() },
  },
  mainEntityOfPage: canonical,
  inLanguage: SITE.lang,
  keywords: data.tags.join(", "),
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
    category && { "@type": "ListItem", position: 2, name: category.name, item: new URL(`/category/${category.slug}`, SITE.url).toString() },
    { "@type": "ListItem", position: 3, name: data.title, item: canonical },
  ].filter(Boolean),
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={data.cover}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  jsonLd={[articleLd, breadcrumbLd]}
>
  <article class="container-narrow py-14 md:py-20">
    <div class="mx-auto max-w-prose">
      <nav aria-label="パンくず" class="text-xs text-ink-500">
        <a href="/" class="hover:underline underline-offset-4">Home</a>
        {category && <> / <a href={`/category/${category.slug}`} class="hover:underline underline-offset-4">{category.name}</a></>}
      </nav>

      <header class="mt-8">
        <h1 class="title-serif text-[28px] font-bold leading-[1.4] text-ink-900 md:text-[38px] md:leading-[1.35]">{data.title}</h1>
        <p class="mt-7 text-[15px] leading-[1.95] text-ink-600">{data.description}</p>
        <AuthorCard
          author={author}
          reviewedBy={reviewedBy}
          pubDate={new Date(data.pubDate)}
          updatedDate={data.updatedDate}
          lastReviewedDate={data.lastReviewedDate}
          variant="byline"
        />
        <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-ink-500">
          <span>読了 約{minutes}分</span>
          {data.pr && <><span class="text-ink-300">·</span><span>本記事にはアフィリエイト広告が含まれます（PR）</span></>}
        </div>
      </header>

      {data.cover && (
        <figure class="not-prose mt-10">
          <div class="overflow-hidden rounded-sm bg-ink-100">
            <img
              src={data.cover}
              alt={data.title}
              width="1200"
              height="675"
              loading="eager"
              decoding="async"
              class="w-full"
              style="aspect-ratio: 16/9; object-fit: cover;"
            />
          </div>
        </figure>
      )}

      {data.experience && (
        <ExperienceNote
          usagePeriod={data.experience.usagePeriod}
          context={data.experience.context}
          itemsTested={data.experience.itemsTested}
        />
      )}

      {data.methodology.length > 0 && <MethodologyBox items={data.methodology} />}

      {headings.filter((h) => h.depth === 2).length > 1 && (
        <nav aria-label="目次" class="my-10 border-t border-b border-ink-200 py-6">
          <p class="text-xs tracking-widest text-ink-500">目次</p>
          <ol class="mt-4 space-y-2 text-sm">
            {headings.filter((h) => h.depth === 2).map((h, i) => (
              <li class="flex gap-3">
                <span class="text-ink-300 tabular-nums">{String(i + 1).padStart(2, "0")}</span>
                <a href={`#${h.slug}`} class="hover:underline underline-offset-4">{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <div class="mt-12">
        <Prose>
          <Content />
        </Prose>
      </div>

      {data.faq.length > 0 && <FaqList items={data.faq} />}
      {data.sources.length > 0 && <Sources items={data.sources} />}

      {data.tags.length > 0 && (
        <div class="not-prose mt-12 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
          <span class="text-xs tracking-widest text-ink-500">TAGS</span>
          {data.tags.map((t) => (
            <a href={`/tag/${t}`} class="text-ink-700 hover:text-ink-900 hover:underline underline-offset-4">#{t}</a>
          ))}
        </div>
      )}

      <ShareButtons title={data.title} url={canonical} />

      <AuthorCard
        author={author}
        reviewedBy={reviewedBy}
        pubDate={new Date(data.pubDate)}
        updatedDate={data.updatedDate}
        lastReviewedDate={data.lastReviewedDate}
        variant="full"
      />
    </div>
  </article>

  {related.length > 0 && (
    <section class="container-narrow border-t border-ink-200 py-14">
      <h2 class="title-serif text-lg font-semibold text-ink-900">関連記事</h2>
      <div class="mt-6 divide-y divide-ink-200">
        {related.map((p) => <PostCard post={p} />)}
      </div>
    </section>
  )}

  <BackToTop />
</BaseLayout>
