---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Prose from "@/components/Prose.astro";
import PostCard from "@/components/PostCard.astro";
import AuthorCard from "@/components/AuthorCard.astro";
import ExperienceNote from "@/components/ExperienceNote.astro";
import MethodologyBox from "@/components/MethodologyBox.astro";
import FaqList from "@/components/FaqList.astro";
import Sources from "@/components/Sources.astro";
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import { CATEGORIES, SITE } from "@/consts";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props { post: CollectionEntry<"posts"> }
const { post } = Astro.props;
const { Content, headings } = await post.render();
const { data } = post;
const category = CATEGORIES.find((c) => c.slug === data.category);

const author = await getEntry(data.author);
const reviewedBy = data.reviewedBy ? await getEntry(data.reviewedBy) : undefined;

const pubDate = new Date(data.pubDate).toISOString();
const updatedDate = data.updatedDate ? new Date(data.updatedDate).toISOString() : pubDate;

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const related = allPosts
  .filter((p) => p.slug !== post.slug && p.data.category === post.data.category)
  .slice(0, 3);

const canonical = new URL(`/posts/${post.slug}`, SITE.url).toString();
const ogImage = data.cover
  ? new URL(data.cover, SITE.url).toString()
  : new URL(SITE.defaultOgImage, SITE.url).toString();

const personLd = (a: typeof author) => ({
  "@type": "Person",
  name: a.data.name,
  description: a.data.bio,
  jobTitle: a.data.role,
  knowsAbout: a.data.expertise,
  ...(a.data.social.website || a.data.social.instagram
    ? {
        sameAs: [
          a.data.social.website,
          a.data.social.instagram && `https://instagram.com/${a.data.social.instagram}`,
          a.data.social.twitter && `https://twitter.com/${a.data.social.twitter.replace(/^@/, "")}`,
        ].filter(Boolean),
      }
    : {}),
});

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.description,
  image: ogImage,
  datePublished: pubDate,
  dateModified: updatedDate,
  author: personLd(author),
  ...(reviewedBy ? { reviewedBy: personLd(reviewedBy) } : {}),
  publisher: {
    "@type": "Organization",
    name: SITE.name,
    url: SITE.url,
    logo: { "@type": "ImageObject", url: new URL("/favicon.svg", SITE.url).toString() },
  },
  mainEntityOfPage: canonical,
  inLanguage: SITE.lang,
  keywords: data.tags.join(", "),
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
    category && { "@type": "ListItem", position: 2, name: category.name, item: new URL(`/category/${category.slug}`, SITE.url).toString() },
    { "@type": "ListItem", position: 3, name: data.title, item: canonical },
  ].filter(Boolean),
};

const jsonLd: Record<string, unknown>[] = [articleLd, breadcrumbLd];
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={data.cover}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  jsonLd={jsonLd}
>
  <article class="container-narrow py-10 md:py-16">
    <nav aria-label="パンくず" class="mb-6 text-xs text-ink-500">
      <a href="/" class="hover:text-ink-900 dark:hover:text-ink-50">Home</a>
      {category && <> / <a href={`/category/${category.slug}`} class="hover:text-ink-900 dark:hover:text-ink-50">{category.name}</a></>}
    </nav>

    <header class="mx-auto max-w-prose">
      <div class="flex flex-wrap items-center gap-3 text-xs text-ink-500">
        {category && <a href={`/category/${category.slug}`} class="tag">{category.name}</a>}
        {data.pr && <span class="tag">PR</span>}
      </div>
      <h1 class="mt-4 text-3xl font-semibold leading-tight tracking-tight md:text-4xl">{data.title}</h1>
      <p class="mt-4 text-base leading-relaxed text-ink-600 dark:text-ink-300">{data.description}</p>
    </header>

    <div class="mx-auto max-w-prose">
      <AuthorCard
        author={author}
        reviewedBy={reviewedBy}
        pubDate={new Date(data.pubDate)}
        updatedDate={data.updatedDate}
        lastReviewedDate={data.lastReviewedDate}
      />

      {data.experience && (
        <ExperienceNote
          usagePeriod={data.experience.usagePeriod}
          context={data.experience.context}
          itemsTested={data.experience.itemsTested}
        />
      )}

      {data.methodology.length > 0 && <MethodologyBox items={data.methodology} />}

      {headings.length > 0 && (
        <aside class="my-10 rounded-2xl border border-ink-100 bg-white p-5 dark:border-ink-800 dark:bg-ink-800/30">
          <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-ink-500">目次</p>
          <ol class="space-y-1.5 text-sm">
            {headings.filter((h) => h.depth === 2).map((h) => (
              <li><a href={`#${h.slug}`} class="hover:text-ink-900 dark:hover:text-ink-50">{h.text}</a></li>
            ))}
          </ol>
        </aside>
      )}
    </div>

    <section class="mt-10">
      <Prose>
        <Content />
      </Prose>
    </section>

    <div class="mx-auto max-w-prose">
      {data.faq.length > 0 && <FaqList items={data.faq} />}
      {data.sources.length > 0 && <Sources items={data.sources} />}

      {data.tags.length > 0 && (
        <div class="mt-12 flex flex-wrap gap-2">
          {data.tags.map((t) => <span class="tag">#{t}</span>)}
        </div>
      )}

      <AuthorCard
        author={author}
        reviewedBy={reviewedBy}
        pubDate={new Date(data.pubDate)}
        updatedDate={data.updatedDate}
        lastReviewedDate={data.lastReviewedDate}
      />
    </div>
  </article>

  {related.length > 0 && (
    <section class="container-narrow py-14">
      <h2 class="mb-6 text-xl font-semibold tracking-tight">同じカテゴリの記事</h2>
      <div class="grid gap-6 md:grid-cols-3">
        {related.map((p) => <PostCard post={p} />)}
      </div>
    </section>
  )}
</BaseLayout>

<script>
  // ItemList JSON-LD をクライアント側で ProductCard から生成
  const products = Array.from(document.querySelectorAll<HTMLElement>("[data-product]"));
  if (products.length > 0) {
    const itemListLd = {
      "@context": "https://schema.org",
      "@type": "ItemList",
      itemListElement: products.map((el, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: {
          "@type": "Product",
          name: el.dataset.name,
          ...(el.dataset.brand ? { brand: { "@type": "Brand", name: el.dataset.brand } } : {}),
          ...(el.dataset.image ? { image: el.dataset.image } : {}),
          ...(el.dataset.verdict ? { description: el.dataset.verdict } : {}),
          ...(el.dataset.rating
            ? {
                review: {
                  "@type": "Review",
                  reviewRating: { "@type": "Rating", ratingValue: el.dataset.rating, bestRating: 5 },
                  author: { "@type": "Organization", name: "Kyampus 編集部" },
                },
              }
            : {}),
        },
      })),
    };
    const s = document.createElement("script");
    s.type = "application/ld+json";
    s.textContent = JSON.stringify(itemListLd);
    document.head.appendChild(s);
  }
</script>
