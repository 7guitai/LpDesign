---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="ページが見つかりません" noindex>
  <section class="container-narrow py-28 text-center">
    <p class="text-xs uppercase tracking-[0.2em] text-ink-500">404</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight md:text-5xl">ページが見つかりません</h1>
    <p class="mt-4 text-ink-600 dark:text-ink-300">URLをご確認いただくか、トップページに戻ってください。</p>
    <a class="btn mt-8" href="/">トップへ戻る</a>
  </section>
</BaseLayout>
