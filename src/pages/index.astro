---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { getCollection } from "astro:content";
import { CATEGORIES, SITE } from "@/consts";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featured, ...rest] = posts;
---

<BaseLayout>
  <section class="border-b border-ink-100 py-16 dark:border-ink-800 md:py-24">
    <div class="container-narrow">
      <p class="text-xs uppercase tracking-[0.2em] text-ink-500">For University Students</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold leading-[1.15] tracking-tight md:text-6xl">
        大学生の毎日に、<br />ちょうどいい道具を。
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-ink-600 dark:text-ink-300">
        {SITE.description}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn" href="/category/gadget">記事を読む</a>
        <a class="btn-outline" href={`https://instagram.com/${SITE.instagram}`} rel="me noopener" target="_blank">Instagramをフォロー</a>
      </div>
    </div>
  </section>

  <section class="container-narrow py-14">
    <div class="mb-8 flex items-baseline justify-between">
      <h2 class="text-2xl font-semibold tracking-tight">Categories</h2>
      <p class="text-sm text-ink-500">探したいジャンルから</p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {CATEGORIES.map((c) => (
        <a
          href={`/category/${c.slug}`}
          class="group block rounded-2xl border border-ink-100 bg-white p-5 transition hover:-translate-y-0.5 hover:shadow-md dark:border-ink-800 dark:bg-ink-800/40"
        >
          <p class="text-xs uppercase tracking-widest text-ink-500">{c.slug}</p>
          <p class="mt-1 text-lg font-semibold tracking-tight">{c.name}</p>
          <p class="mt-2 text-sm text-ink-600 dark:text-ink-300">{c.description}</p>
          <span class="mt-4 inline-block text-sm text-ink-900 opacity-0 transition group-hover:opacity-100 dark:text-ink-50">読む →</span>
        </a>
      ))}
    </div>
  </section>

  {featured && (
    <section class="container-narrow py-10">
      <h2 class="mb-6 text-2xl font-semibold tracking-tight">Featured</h2>
      <PostCard post={featured} featured />
    </section>
  )}

  {rest.length > 0 && (
    <section class="container-narrow py-10">
      <h2 class="mb-6 text-2xl font-semibold tracking-tight">Latest</h2>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {rest.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  )}
</BaseLayout>
