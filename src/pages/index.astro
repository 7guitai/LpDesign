---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { getCollection } from "astro:content";
import { CATEGORIES, SITE } from "@/consts";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout>
  <section class="container-narrow pt-20 pb-16 md:pt-28 md:pb-24">
    <h1 class="title-serif text-[32px] font-semibold leading-[1.4] text-ink-900 md:text-[44px] md:leading-[1.3]">
      大学生の毎日に、<br />ちょうどいい道具を。
    </h1>
    <p class="mt-8 max-w-xl text-[15px] leading-[1.95] text-ink-600">
      {SITE.description}
    </p>
  </section>

  <section class="container-narrow border-t border-ink-200 py-12">
    <h2 class="title-serif text-lg font-semibold text-ink-900">最新の記事</h2>
    <div class="mt-6 divide-y divide-ink-200">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <section class="container-narrow border-t border-ink-200 py-12">
    <h2 class="title-serif text-lg font-semibold text-ink-900">ジャンルから探す</h2>
    <ul class="mt-4 divide-y divide-ink-100">
      {CATEGORIES.map((c) => (
        <li>
          <a href={`/category/${c.slug}`} class="group block py-5">
            <div class="flex items-baseline justify-between gap-4">
              <p class="title-serif text-lg font-semibold text-ink-900 group-hover:underline underline-offset-4">
                {c.name}
              </p>
              <span class="text-sm text-ink-400 transition group-hover:text-ink-900">→</span>
            </div>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-600">{c.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
