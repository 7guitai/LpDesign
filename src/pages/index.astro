---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { getCollection } from "astro:content";
import { CATEGORIES, SITE } from "@/consts";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout>
  <section class="container-narrow pt-20 pb-14 md:pt-28 md:pb-20">
    <h1 class="title-serif text-4xl font-bold leading-[1.3] md:text-5xl md:leading-[1.25]">
      大学生の毎日に、<br />ちょうどいい道具を。
    </h1>
    <p class="mt-6 max-w-xl text-base leading-[1.9] text-ink-600 dark:text-ink-300">
      {SITE.description}
    </p>
  </section>

  <section class="container-narrow border-t border-ink-200 py-12 dark:border-ink-800">
    <h2 class="title-serif text-xl font-bold">最新の記事</h2>
    <div class="mt-8 divide-y divide-ink-200 dark:divide-ink-800">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <section class="container-narrow border-t border-ink-200 py-12 dark:border-ink-800">
    <h2 class="title-serif text-xl font-bold">ジャンルから探す</h2>
    <ul class="mt-6 space-y-4">
      {CATEGORIES.map((c) => (
        <li>
          <a href={`/category/${c.slug}`} class="group block py-2">
            <p class="title-serif text-lg font-bold group-hover:underline underline-offset-4">{c.name}</p>
            <p class="mt-1 text-sm leading-relaxed text-ink-600 dark:text-ink-300">{c.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
